<style>

/* ================= TOKENS ================= */
:root{
 --ivory:#F7F4EE;--white:#FFFFFF;--ink:#191919;--taupe:#898176;--sand:#D8C9B5;--gold:#B39A70;
 --bg:var(--ivory);--surface:var(--white);--tone:#EDE6DA;--mute:#6F685E;--line:#E2DACD;--line-strong:#CDBFAA;
 --accent:var(--ink);--onaccent:var(--ivory);--dark:#191919;--ondark:#F7F4EE;--ondark-mute:#B5ADA2;
 --serif:'Playfair Display','Didot','Bodoni 72',Georgia,serif;--sans:'Jost','Helvetica Neue',Arial,sans-serif;
 --gut:clamp(16px,4vw,48px);--max:1320px;--hh:76px;--ease:cubic-bezier(.2,.7,.2,1);
 color-scheme:light}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){
 --bg:#171615;--surface:#1F1D1B;--tone:#2A2723;--ink:#F3EFE8;--mute:#ADA59A;--taupe:#ADA59A;--line:#34302B;--line-strong:#4A443C;
 --accent:#F3EFE8;--onaccent:#191919;--dark:#0F0E0D;--gold:#C7AE84;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#171615;--surface:#1F1D1B;--tone:#2A2723;--ink:#F3EFE8;--mute:#ADA59A;--taupe:#ADA59A;--line:#34302B;--line-strong:#4A443C;--accent:#F3EFE8;--onaccent:#191919;--dark:#0F0E0D;--gold:#C7AE84;color-scheme:dark}

/* ================= BASE ================= */
*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:calc(var(--hh) + 24px);-webkit-text-size-adjust:100%}
body{margin:0;background:var(--bg);color:var(--ink);font:400 16px/1.6 var(--sans);overflow-x:clip;-webkit-font-smoothing:antialiased;padding-bottom:env(safe-area-inset-bottom,0px)}
body.lock{overflow:hidden}
[hidden]{display:none!important}
img{max-width:100%;display:block}
button,input,select,textarea{font:inherit;color:inherit}
a{color:inherit;text-decoration:none}
button{cursor:pointer;background:none;border:0;padding:0}
:focus-visible{outline:1.5px solid var(--ink);outline-offset:3px}
h1,h2,h3,h4{margin:0;font-weight:400}
p{margin:0}
.wrap{max-width:var(--max);margin:0 auto;padding:0 var(--gut)}
.sec{padding:clamp(64px,9vw,128px) 0}
.serif{font-family:var(--serif)}
.h2{font-family:var(--serif);font-size:clamp(30px,4vw,48px);line-height:1.08;letter-spacing:-.01em}
.lead{color:var(--mute);font-size:17px;max-width:46ch}
.note{font-size:13px;color:var(--mute)}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}

/* Buttons */
.btn{white-space:nowrap;display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:50px;padding:0 30px;background:var(--accent);color:var(--onaccent);border:1px solid var(--accent);font-size:15px;font-weight:400;letter-spacing:.04em;transition:background .25s,color .25s,border-color .25s}
.btn:hover{background:transparent;color:var(--ink)}
.btn.line{background:transparent;color:var(--ink);border-color:var(--line-strong)}
.btn.line:hover{border-color:var(--ink)}
.btn.sm{min-height:44px;padding:0 18px;font-size:14px}
.btn.block{width:100%}
.btn[disabled]{opacity:.4;cursor:not-allowed;pointer-events:none}
.link{display:inline-flex;align-items:center;min-height:44px;font-size:15px;letter-spacing:.03em;border-bottom:1px solid currentColor;padding-bottom:2px;line-height:1.2;min-height:auto}
.ib{position:relative;width:44px;height:44px;display:grid;place-items:center;border-radius:50%;transition:background .2s}
.ib:hover{background:color-mix(in srgb,var(--ink) 6%,transparent)}
.ib svg{width:21px;height:21px;fill:none;stroke:currentColor;stroke-width:1.25;stroke-linecap:round;stroke-linejoin:round}
.cnt{position:absolute;top:5px;right:3px;min-width:17px;height:17px;padding:0 4px;border-radius:9px;background:var(--ink);color:var(--bg);font-size:10.5px;line-height:17px;text-align:center}

/* ================= ANNOUNCEMENT + HEADER ================= */
.ann{background:var(--dark);color:var(--ondark);font-size:13px;letter-spacing:.04em;height:36px;display:grid;place-items:center;padding:0 16px;text-align:center;padding-top:env(safe-area-inset-top,0px);box-sizing:content-box}
.ann span{transition:opacity .5s}
.ann span.out{opacity:0}
header.top{position:sticky;top:0;z-index:40;background:color-mix(in srgb,var(--bg) 94%,transparent);backdrop-filter:saturate(1.2) blur(10px);-webkit-backdrop-filter:saturate(1.2) blur(10px);border-bottom:1px solid transparent;transition:border-color .3s}
header.top.scrolled{border-bottom-color:var(--line)}
.bar{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;height:var(--hh)}
nav.main{display:flex;gap:30px}
nav.main a{font-size:14.5px;letter-spacing:.05em;padding:8px 0;position:relative}
nav.main a::after{content:"";position:absolute;left:0;right:0;bottom:2px;height:1px;background:var(--ink);transform:scaleX(0);transform-origin:left;transition:transform .35s var(--ease)}
nav.main a:hover::after{transform:scaleX(1)}
.logo{display:block;width:150px;height:56px;overflow:hidden}
.logo img{width:100%;height:100%;object-fit:contain;object-position:center}
.tools{display:flex;justify-content:flex-end;align-items:center;gap:2px}
.burger{display:none;margin-left:-10px}
.searchbar{border-top:1px solid var(--line);background:var(--bg)}
.searchbar .wrap{display:flex;align-items:center;gap:14px;height:72px}
.searchbar svg{width:20px;height:20px;fill:none;stroke:var(--mute);stroke-width:1.3;flex:none}
.searchbar input{flex:1;border:0;background:none;font-family:var(--serif);font-size:clamp(20px,2.4vw,26px);outline:0;min-width:0}
.searchbar input::placeholder{color:var(--taupe)}

/* Mobile menu */
.mm{position:fixed;inset:0;z-index:70;background:var(--bg);display:flex;flex-direction:column;padding:calc(env(safe-area-inset-top,0px) + 10px) var(--gut) calc(env(safe-area-inset-bottom,0px) + 24px);overflow-y:auto;opacity:0;visibility:hidden;transition:opacity .3s,visibility 0s .3s}
.mm.open{opacity:1;visibility:visible;transition:opacity .3s}
.mm-head{display:flex;justify-content:space-between;align-items:center;height:64px}
.mm input{height:52px;border:0;border-bottom:1px solid var(--line-strong);background:none;font-size:17px;outline:0;margin:12px 0 18px;width:100%}
.mm nav{display:grid}
.mm nav a{font-family:var(--serif);font-size:30px;line-height:1.2;padding:12px 0;border-bottom:1px solid var(--line)}
.mm .mm-sub{display:grid;gap:4px;margin-top:28px}
.mm .mm-sub a,.mm .mm-sub button{font-size:16px;color:var(--mute);text-align:left;padding:10px 0;min-height:44px}

/* ================= CATALOG ================= */
.catalog{background:var(--surface)}
.chips{display:flex;gap:6px;overflow-x:auto;scrollbar-width:none;padding-bottom:2px;margin-bottom:18px}
.chips::-webkit-scrollbar{display:none}
.chip{flex:none;height:40px;padding:0 18px;border:1px solid var(--line);border-radius:20px;font-size:14.5px;transition:border-color .2s,background .2s,color .2s}
.chip:hover{border-color:var(--ink)}
.chip.on{background:var(--ink);color:var(--bg);border-color:var(--ink)}
.tb{display:flex;flex-wrap:wrap;align-items:center;gap:10px 26px;padding:14px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line);margin-bottom:clamp(28px,4vw,44px)}
.sel{position:relative;display:inline-flex;align-items:center}
.sel select{appearance:none;-webkit-appearance:none;border:0;background-color:var(--surface);color:var(--ink);height:44px;padding:0 22px 0 0;font-size:14.5px;cursor:pointer}
.sel::after{content:"";position:absolute;right:4px;top:50%;width:6px;height:6px;border-right:1px solid currentColor;border-bottom:1px solid currentColor;transform:translateY(-70%) rotate(45deg);pointer-events:none}
/* Opciones de los menús desplegables: siempre texto oscuro sobre fondo claro (o al revés en modo oscuro) */
select option,select optgroup{background-color:var(--surface);color:var(--ink)}
select option:disabled{color:var(--taupe)}
.chk{display:inline-flex;align-items:center;gap:9px;font-size:14.5px;cursor:pointer;min-height:44px}
.chk input{appearance:none;-webkit-appearance:none;width:16px;height:16px;border:1px solid var(--line-strong);margin:0;display:grid;place-items:center;cursor:pointer}
.chk input:checked{background:var(--ink);border-color:var(--ink)}
.chk input:checked::after{content:"";width:4px;height:8px;border:solid var(--bg);border-width:0 1.5px 1.5px 0;transform:translateY(-1px) rotate(45deg)}
.tb .count{margin-left:auto;color:var(--mute);font-size:14px}
.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:clamp(36px,4vw,56px) clamp(14px,1.6vw,24px)}
.card{display:flex;flex-direction:column;position:relative}
.media{position:relative;aspect-ratio:3/4;overflow:hidden;background:var(--tone)}
.media .im{display:block;width:100%;height:100%}
.media img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:opacity .6s var(--ease),transform 1.1s var(--ease)}
.media img.alt{opacity:0}
@media(hover:hover){.card:hover .media img.alt{opacity:1}.card:hover .media img{transform:scale(1.025)}}
.tag{position:absolute;top:12px;left:12px;background:var(--bg);color:var(--ink);font-size:12px;letter-spacing:.04em;padding:4px 10px;pointer-events:none}
.fav{position:absolute;top:6px;right:6px;z-index:2}
.fav svg{width:19px;height:19px}
.fav.on svg{fill:currentColor}
.card .info{padding:16px 0 14px;flex:1}
.card h3{font-size:15.5px;font-weight:400;line-height:1.35;letter-spacing:.01em}
.pr{display:flex;flex-wrap:wrap;gap:4px 10px;align-items:baseline;margin-top:6px;font-size:15px}
.pr b{font-weight:500}
.pr s{color:var(--taupe);font-size:14px}
.pr .off{color:var(--gold);font-size:13px;letter-spacing:.02em}
.low{font-size:13px;color:var(--mute);margin-top:6px}
.empty{grid-column:1/-1;padding:64px 0;text-align:center;color:var(--mute)}
.empty .btn{margin-top:18px}

/* ================= CATEGORY SECTION PAGES ================= */
.navb{font-size:14.5px;letter-spacing:.05em;padding:8px 0;display:inline-flex;align-items:center;gap:8px}
.navb::after{content:"";width:5px;height:5px;border-right:1px solid currentColor;border-bottom:1px solid currentColor;transform:translateY(-2px) rotate(45deg);transition:transform .3s}
.navb[aria-expanded="true"]::after{transform:translateY(1px) rotate(-135deg)}
.mega{border-top:1px solid var(--line);background:var(--bg);box-shadow:0 24px 40px -32px rgba(25,25,25,.35)}
.mega-g{list-style:none;margin:0;padding:28px 0 32px;display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:16px}
.mega-g a{display:block}
.mega-g .mi{display:block;aspect-ratio:4/5;background:var(--tone);overflow:hidden;margin-bottom:12px}
.mega-g img{width:100%;height:100%;object-fit:cover;transition:transform .8s var(--ease)}
.mega-g a:hover img{transform:scale(1.04)}
.mega-g b{display:block;font-family:var(--serif);font-weight:400;font-size:19px;line-height:1.2}
.mega-g small{display:block;color:var(--mute);font-size:13.5px;margin-top:3px;line-height:1.4}
.mega-all a{width:100%;display:flex;flex-direction:column;justify-content:flex-end;padding:18px;border:1px solid var(--line-strong);aspect-ratio:4/5;transition:border-color .2s}
.mega-all a:hover{border-color:var(--ink)}
.chero{border-bottom:1px solid var(--line)}
.chero-in{display:grid;grid-template-columns:minmax(0,7fr) minmax(0,5fr);gap:clamp(24px,5vw,80px);align-items:end;padding-top:clamp(8px,2vw,24px);padding-bottom:clamp(36px,5vw,64px)}
.chero h1{font-family:var(--serif);font-size:clamp(52px,8vw,120px);line-height:.95;letter-spacing:-.03em;margin-bottom:22px}
.chero .lead{font-size:18px}
.cmeta{margin-top:18px;font-size:14px;color:var(--mute);letter-spacing:.02em}
.chero figure{margin:0;aspect-ratio:5/4;background:var(--tone);overflow:hidden}
.chero figure img{width:100%;height:100%;object-fit:cover}
.ctabs{position:sticky;top:var(--hh);z-index:20;background:color-mix(in srgb,var(--bg) 96%,transparent);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}
.ctabs ul{list-style:none;margin:0;padding:0;display:flex;gap:clamp(18px,3vw,40px);overflow-x:auto;scrollbar-width:none}
.ctabs ul::-webkit-scrollbar{display:none}
.ctabs a{display:flex;align-items:center;height:54px;font-size:14.5px;letter-spacing:.04em;color:var(--mute);white-space:nowrap;border-bottom:1px solid transparent;transition:color .2s,border-color .2s}
.ctabs a:hover{color:var(--ink)}
.ctabs a.on{color:var(--ink);border-bottom-color:var(--ink)}
.ctabs li:last-child{margin-left:auto}
.pn{border-top:1px solid var(--line)}
.pn .wrap{display:grid;grid-template-columns:1fr 1fr}
.pn-a{display:flex;flex-direction:column;gap:6px;padding:clamp(36px,5vw,64px) 0}
.pn-a.nx{text-align:right;align-items:flex-end;border-left:1px solid var(--line)}
.pn-a small{font-size:13.5px;color:var(--mute);letter-spacing:.03em}
.pn-a span{font-family:var(--serif);font-size:clamp(26px,3.4vw,42px);line-height:1.1;transition:opacity .2s}
.pn-a:hover span{opacity:.6}
.chip.go{border-color:transparent;text-decoration:underline;text-underline-offset:4px;display:inline-flex;align-items:center}
.mm-cats{border-bottom:1px solid var(--line)}
.mm-cats summary{font-family:var(--serif);font-size:30px;line-height:1.2;padding:12px 0;list-style:none;cursor:pointer;display:flex;justify-content:space-between;align-items:center}
.mm-cats summary::-webkit-details-marker{display:none}
.mm-cats summary::after{content:"+";font-family:var(--sans);font-weight:300;font-size:24px;color:var(--mute)}
.mm-cats[open] summary::after{content:"−"}
.mm-cats div{display:grid;padding:0 0 14px 2px}
.mm .mm-cats a{font-family:var(--sans);font-size:17px;border:0;padding:9px 0;color:var(--mute)}

/* ================= MENSAJES ================= */
.msg{margin-top:14px;font-size:14.5px;min-height:22px;color:var(--mute)}

/* ================= FOOTER ================= */
footer{background:var(--dark);color:var(--ondark);padding:clamp(56px,7vw,96px) 0 calc(28px + env(safe-area-inset-bottom,0px))}
.fg{display:grid;grid-template-columns:1.4fr 1fr 1fr 1.15fr 1fr;gap:clamp(28px,4vw,56px)}
footer .logo{width:127px;height:64px}
footer .logo img{filter:invert(1)}
footer .about{color:var(--ondark-mute);font-size:15px;max-width:34ch;margin-top:16px;line-height:1.65}
footer address{font-style:normal;color:var(--ondark-mute);font-size:15px;margin-top:18px;line-height:1.7}
footer h4{font-family:var(--serif);font-size:19px;margin-bottom:16px}
footer ul{list-style:none;margin:0;padding:0;display:grid;gap:4px}
footer li{font-size:15px;color:var(--ondark-mute)}
footer li a,footer li button{display:inline-flex;min-height:36px;align-items:center;text-align:left;transition:color .2s}
footer li a:hover,footer li button:hover{color:var(--ondark)}
.fbot{display:flex;flex-wrap:wrap;justify-content:space-between;gap:12px 32px;margin-top:clamp(48px,6vw,80px);padding-top:24px;border-top:1px solid rgba(247,244,238,.14);font-size:13px;color:var(--ondark-mute)}
.fbot p{max-width:70ch}

/* ================= DRAWER ================= */
.ov{position:fixed;inset:0;background:rgba(25,25,25,.4);z-index:60;opacity:0;visibility:hidden;transition:opacity .3s,visibility 0s .3s}
.ov.open{opacity:1;visibility:visible;transition:opacity .3s}
.drawer{position:fixed;top:0;right:0;bottom:0;width:min(440px,100%);background:var(--bg);z-index:61;transform:translateX(100%);transition:transform .45s var(--ease),visibility 0s .45s;visibility:hidden;display:flex;flex-direction:column;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
.drawer.open{transform:none;visibility:visible;transition:transform .45s var(--ease)}
.dh{display:flex;justify-content:space-between;align-items:center;padding:14px 16px 14px 24px;border-bottom:1px solid var(--line)}
.dh h2{font-family:var(--serif);font-size:24px}
.ship{padding:16px 24px;border-bottom:1px solid var(--line);font-size:14px;color:var(--mute)}
.ship .bar2{height:2px;background:var(--line);margin-top:10px}
.ship .bar2 i{display:block;height:100%;background:var(--gold);transition:width .5s var(--ease)}
.db{flex:1;overflow:auto;padding:0 24px;overscroll-behavior:contain}
.df{padding:20px 24px;border-top:1px solid var(--line);display:grid;gap:10px}
.db .line{display:grid;grid-template-columns:84px 1fr;gap:16px;padding:20px 0;border-bottom:1px solid var(--line)}
.db .line img{width:84px;height:112px;object-fit:cover;background:var(--tone)}
.db .line b{font-weight:400;font-size:15px;display:block;line-height:1.35}
.db .line .meta{font-size:13.5px;color:var(--mute);margin:3px 0 6px}
.qty{display:inline-flex;align-items:center;border:1px solid var(--line-strong)}
.qty button{width:40px;height:40px;font-size:17px;display:grid;place-items:center}
.qty span{min-width:28px;text-align:center;font-size:15px}
.rm{color:var(--mute);font-size:13.5px;text-decoration:underline;text-underline-offset:3px;margin-left:14px;min-height:40px}
.row{display:flex;justify-content:space-between;gap:16px;font-size:15px}
.row.tot{font-size:18px;font-weight:500;padding-top:6px}
.df .empty{padding:0}

/* ================= DETAIL ================= */
.crumb{padding:22px 0;color:var(--mute);font-size:13.5px;display:flex;flex-wrap:wrap;gap:8px}
.crumb a,.crumb button{text-decoration:underline;text-underline-offset:3px;text-decoration-color:var(--line-strong)}
.crumb a:hover,.crumb button:hover{color:var(--ink)}
.pd{display:grid;grid-template-columns:minmax(0,7fr) minmax(0,5fr);gap:clamp(28px,5vw,80px);padding-bottom:clamp(64px,8vw,112px)}
.gal{display:grid;grid-template-columns:72px 1fr;gap:14px;align-items:start}
.gal .main{grid-column:2;grid-row:1;aspect-ratio:3/4;width:100%;object-fit:cover;background:var(--tone)}
.thumbs{grid-column:1;grid-row:1;display:grid;gap:10px}
.thumbs button{border:1px solid transparent;padding:0;background:var(--tone);opacity:.7;transition:opacity .2s,border-color .2s}
.thumbs button.on,.thumbs button:hover{opacity:1;border-color:var(--ink)}
.thumbs img{aspect-ratio:3/4;object-fit:cover;width:100%}
.buy{position:sticky;top:calc(var(--hh) + 24px);align-self:start}
.buy .cat-n{font-size:14px;color:var(--mute);letter-spacing:.04em}
.buy h1{font-family:var(--serif);font-size:clamp(30px,3.4vw,44px);line-height:1.1;margin:10px 0 14px}
.buy .pr{font-size:20px;margin:0 0 22px}
.buy .pr s{font-size:17px}
.buy .desc{color:var(--mute);line-height:1.7;margin-bottom:26px;max-width:48ch}
.opt-l{display:flex;justify-content:space-between;font-size:14.5px;margin-bottom:10px}
.opt-l span{color:var(--mute)}
