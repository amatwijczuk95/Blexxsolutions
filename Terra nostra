/* Panel de compra reutilizable (ficha y vista rápida). Valida color, talle y stock por variante. */
function buyPanel(p,onColor){const el=document.createElement("div");el.className="buyp";
 const st={color:p.colors.length===1?p.colors[0]:null,size:null,q:1,err:""};
 if(p.sizes.length===1&&(!st.color||vStock(p,st.color,p.sizes[0])>0)&&sizeOk(p,p.sizes[0]))st.size=p.sizes[0];
 const out=totalStock(p)<1;
 const draw=()=>{const c=st.color,s=st.size,n=c&&s?vStock(p,c,s):null;
  const avl=out?"":n===null?"":n<1?"No hay stock de esta combinación.":n<=CONFIG.lowStock?`Últimas unidades: quedan ${n}.`:"Disponible para comprar.";
  el.innerHTML=`<div class="opt-l"><b style="font-weight:400">Color</b><span>${c?esc(c):"Elegí un color"}</span></div><div class="opt" role="group" aria-label="Color">${p.colors.map(x=>{const ok=colorOk(p,x);return `<button type="button" data-c="${esc(x)}" class="${x===c?"on":""}" aria-pressed="${x===c}" ${ok?"":`disabled aria-label="${esc(x)}, sin stock"`}>${sw(x)}${esc(x)}</button>`}).join("")}</div>
  <div class="opt-l"><b style="font-weight:400">Talle</b><span>${s?esc(s):"Elegí un talle"}</span></div><div class="opt" role="group" aria-label="Talle">${p.sizes.map(x=>{const ok=c?vStock(p,c,x)>0:sizeOk(p,x);return `<button type="button" data-s="${esc(x)}" class="${x===s?"on":""}" aria-pressed="${x===s}" ${ok?"":`disabled aria-label="Talle ${esc(x)}, sin stock${c?" en "+esc(c):""}"`}>${esc(x)}</button>`}).join("")}</div>
  ${CONFIG.sizeGuide&&p.sizes.length>1?`<button type="button" class="sgbtn" data-a="sizeguide" style="margin:-12px 0 16px">Guía de talles</button>`:""}
  <p class="avl${n!==null&&n<1?" no":""}" aria-live="polite">${avl}</p>
  <div class="opt-l"><b style="font-weight:400">Cantidad</b></div><div class="opt"><span class="qty"><button type="button" data-q="-1" aria-label="Restar">−</button><span aria-live="polite">${st.q}</span><button type="button" data-q="1" aria-label="Sumar">+</button></span></div>
  <div class="err" role="alert">${esc(st.err)}</div><button type="button" class="btn block" data-add ${out?"disabled":""}>${out?"Sin stock":"Agregar al carrito"}</button>`};
 el.addEventListener("click",e=>{const b=e.target.closest("[data-c],[data-s],[data-q],[data-add]");if(!b||b.disabled)return;const d=b.dataset;st.err="";
  if(d.c){st.color=d.c;if(st.size&&vStock(p,st.color,st.size)<1)st.size=null;onColor&&onColor(st.color)}
  else if(d.s)st.size=d.s;
  else if(d.q){const max=st.color&&st.size?Math.max(1,remaining(p,st.color,st.size)):99;st.q=Math.max(1,Math.min(max,st.q+ +d.q))}
  else if(d.add!==undefined){if(!st.color||!st.size){st.err="Elegí "+(!st.color?"un color":"")+(!st.color&&!st.size?" y ":"")+(!st.size?"un talle":"")+" para continuar.";draw();return}
   if(addToCart(p.id,st.color,st.size,st.q)){toast(`Agregado al carrito: ${p.name} (${st.color}, ${st.size})`);el.dispatchEvent(new CustomEvent("added",{bubbles:true}));openCart(true);st.q=1}draw();return}
  draw()});
 draw();return el}

